# Contact form — server-side only. Copy to .env.local for development.
# None of these may be prefixed with NEXT_PUBLIC_, or they would be exposed
# to the browser.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=YOUR_REAL_KEY_HERE

# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=YOUR_EMAIL_HERE

# Sender address. "onboarding@resend.dev" works with no domain setup, but can
# only deliver to the email address that owns the Resend account. Once you
# verify your own domain in Resend, change this to an address on that domain.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
